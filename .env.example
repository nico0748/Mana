# Copy to .env and adjust values
# - コンテナ内 backend からは host=db を使う（docker-compose のサービス名）
# - ホストから直接 npm run dev する場合は host=localhost、port=5433 にする
DATABASE_URL=postgresql://mana:mana_password@db:5432/mana_library
PORT=3000

# ── Stripe (Pro プラン用) ──
# 開発時は test mode (sk_test_...) を使用。Stripe ダッシュボードから取得。
STRIPE_SECRET_KEY=
# Webhook signing secret。stripe listen --forward-to ... が表示する whsec_... を貼る。
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard で作成した recurring price の ID
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Stripe Checkout から戻ってくる先のフロントエンド URL
APP_URL=http://localhost:5173

# ── 管理者 ──────────────────────────────────────────────────
# 管理者画面 (/admin) にアクセス可能にする Firebase UID をカンマ区切りで指定。
# ここに含まれる UID は毎回の認証時に role=admin / proOverride=true を強制反映する
# （DB を直接書き換えても次回ログインで戻る）。
INITIAL_ADMIN_UIDS=
