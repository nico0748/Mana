# Copy to .env and adjust values
DATABASE_URL=postgresql://doujin:doujin_password@db:5432/doujin_pp
PORT=3000

# ── Stripe (Pro プラン用) ──
# 開発時は test mode (sk_test_...) を使用。Stripe ダッシュボードから取得。
STRIPE_SECRET_KEY=
# Webhook signing secret。stripe listen --forward-to ... が表示する whsec_... を貼る。
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard で作成した recurring price の ID
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Stripe Checkout から戻ってくる先のフロントエンド URL
APP_URL=http://localhost:5173
