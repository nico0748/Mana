# ============================================================
# 本番環境変数テンプレート
# cp .env.prod.example .env.prod して値を設定してください
# .env.prod は絶対に Git にコミットしないこと！
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=doujin_pp
POSTGRES_USER=doujin
# 強力なパスワードを設定（例: openssl rand -base64 32 で生成）
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Prisma が使う接続文字列（POSTGRES_* と合わせること）
DATABASE_URL=postgresql://doujin:CHANGE_THIS_STRONG_PASSWORD@db:5432/doujin_pp

# ── Backend ─────────────────────────────────────────────────
PORT=3000
# 自分のドメインに変更（末尾スラッシュなし）
CORS_ORIGIN=https://yourdomain.com

# ── Stripe (本番) ───────────────────────────────────────────
# 必ず live mode のキー (sk_live_...) を設定すること
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
# Stripe Dashboard → Developers → Webhooks で endpoint 登録後に取得
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Stripe Dashboard で作成した recurring price の ID
STRIPE_PRICE_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_YEARLY=price_CHANGE_ME
# Checkout 完了後の戻り先 (https://yourdomain.com)
APP_URL=https://yourdomain.com
