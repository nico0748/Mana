generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  author    String
  isbn      String?
  type      String
  category  String?
  ndcCode   String?
  status    String
  price     Int?
  memo      String?
  coverUrl   String?
  circleName String?
  // 同じシリーズ（例: 青春ブタ野郎、ソードアート・オンライン）でまとめるためのタグ。
  series     String?
  // ジャンル（例: 恋愛、バトル、SF）でまとめるためのタグ。
  genre      String?
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DoujinEvent {
  id        String    @id @default(uuid())
  userId    String?
  name      String
  date      String?
  budget    Int?
  // MAP ヘッダーでの手動並べ替え順。null = 未設定で、開催日などの自動ソートにフォールバックする。
  order     Int?
  // 色に付ける名前。{ "red": "代理購入", "blue": "自分用" } の形。
  // 即売会ごとに意味が変わるのでイベント側に持つ。
  colorLabels Json?
  circles   Circle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Circle {
  id           String       @id @default(uuid())
  userId       String?
  event        DoujinEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String?
  name         String
  author       String
  hall         String
  block        String
  number       String
  order        Int
  status       String
  // サークルの色分け（ジャンル分け / 代理購入と自分用の区別など）。
  // 値は共有パレットのキー（red, blue, …）。null は未設定。
  color        String?
  xUrl         String?
  menuImageUrl String?
  // ピンを置いた会場マップのページ。null は 1 ページ目（ページ概念の導入前に
  // 置かれたピンが 1 ページ目に残るようにするため、既定値ではなく null 許容）。
  mapPage      Int?
  mapX         Float?
  mapY         Float?
  items        CircleItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CircleItem {
  id                   String  @id @default(uuid())
  circle               Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  circleId             String
  title                String
  type                 String
  price                Int
  quantity             Int
  coverUrl             String?
  status               String  @default("pending")
  onlineStatus         String  @default("unchecked")
  addedToLibraryBookId String?
}

model VenueMap {
  id           String   @id @default(uuid())
  userId       String?
  eventId      String?
  hall         String
  // 複数ページ PDF の何ページ目か。1 始まり。
  // ページごとに 1 レコード持つことで、切り抜き結果がページ単位で残り、
  // ピンもページを跨いで出てこなくなる。単一画像のマップは常に 1。
  page         Int      @default(1)
  imageDataUrl String
  generatedSvg String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, hall, page])
}

model Distribution {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  price     Int
  stock     Int
  sold      Int
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  firebaseUid          String    @id
  email                String?
  displayName          String?

  role                 String    @default("user")
  proOverride          Boolean   @default(false)

  plan                 String    @default("free")
  planStatus           String    @default("inactive")
  planInterval         String?
  planExpiresAt        DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  apiKeys              ApiKey[]

  @@index([stripeCustomerId])
  @@index([role])
}

// MCP サーバなど、ブラウザ外のクライアントから API を叩くための長期クレデンシャル。
// Firebase ID トークンは有効期限 1 時間で自動更新もできないため、代替として用意する。
model ApiKey {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)
  userId     String
  // 用途がわかる表示名（"Claude Code の MCP" など）
  name       String
  // 平文は発行時に一度返すだけで保存しない。照合は SHA-256 ハッシュで行う。
  keyHash    String    @unique
  // 一覧画面でどのキーか見分けるための先頭数文字（例 "mana_sk_a1b2c3"）
  prefix     String
  lastUsedAt DateTime?
  // 失効は物理削除ではなく日時記録。いつ切ったかを追えるようにする。
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  imageUrl  String?
  category  String   @default("info")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model EventTemplate {
  id              String    @id @default(uuid())
  // 申請時のスナップショット。元イベントが後で消されても残す。
  name            String
  date            String?
  // [{ hall, imageDataUrl, generatedSvg? }]
  venueMaps       Json
  // [{ name, author, hall, block, number, order, xUrl?, menuImageUrl?, mapX?, mapY? }]
  circles         Json      @default("[]")
  // 申請メタ
  submittedByUid  String
  sourceEventId   String?
  // 承認状態
  status          String    @default("pending")
  reviewedByUid   String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([submittedByUid])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  // 表示順。小さい順に上から表示する。
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorUid   String
  action     String
  targetUid  String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorUid])
  @@index([targetUid])
}
